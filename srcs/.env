# ==== Database Credentials ====
# DB_NAME:  name of WordPress database
# DB_HOST:  hostname of MariaDB service
# DB_USER:  username for accessing WordPress database
# DB_PW:  password for DB_USER.
# ROOT_PW:  root password for MariaDB database

# === WordPress Configuration ====
# WP_URL:  URL of the WordPress site
# WP_TITLE:  title of the WordPress site
# WP_ADMIN_N:  username for WordPress admin account
# WP_ADMIN_PW:  password for WordPress admin account
# WP_ADMIN_MAIL:  email address for the WordPress admin account

# ==== WordPress User Configuration ====
# WP_USER:  username for a regular WordPress user
# WP_USER_EMAIL:  email address for regular WordPress user
# WP_USER_PW:  password